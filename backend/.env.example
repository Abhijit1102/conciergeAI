MONGODB_URL=mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/aieventconcierge
# Set SKIP_MONGODB=true to run without MongoDB (auth/query/history return 503)
DB_NAME=aieventconcierge
JWT_SECRET=<minimum-32-char-random-string>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-1.5-flash
FRONTEND_URL=https://your-app.vercel.app
ENVIRONMENT=production
